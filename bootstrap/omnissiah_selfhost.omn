// Omnissiah++ R04: self-hosted structural AST, core AST and native compiler.
// Stage 0: Python R01 builds this source once.
// Stage 1+: this executable translates this same .omn source without Python.
#include <algorithm>
#include <array>
#include <cerrno>
#include <cstddef>
#include <cstdlib>
#include <filesystem>
