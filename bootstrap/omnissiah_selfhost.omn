    {"𐍉", "o"},
};

string canonical_identifier(const string& word, const string& dialect) {
    if (dialect == "ru") return word;
    string transliterated;
    if (dialect == "gothic") {
        for (size_t i = 0; i < word.size();) {
            if (i + 4 <= word.size()) {
                string letter = word.substr(i, 4);
                auto found = GOTHIC_LETTERS.find(letter);
                if (found != GOTHIC_LETTERS.end()) {
                    transliterated += found->second;
                    i += 4;
                    continue;
                }
            }
            transliterated += word[i++];
        }
    } else transliterated = word;
    string key = transliterated;
    for (char& c : key) {
        if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
    }
    auto found = HIGH_GOTHIC.find(key);
    return found == HIGH_GOTHIC.end() ? transliterated : found->second;
}

string canonical_core_source(const string& source, const string& dialect) {
    // Needed by the restricted grammar backend; source-ast itself remains lossless.
    if (dialect == "ru") return source;
    const auto tokens = lex(source);
    string result = source;
    for (auto it = tokens.rbegin(); it != tokens.rend(); ++it) {
        if (it->kind != "identifier") continue;
        string word = canonical_identifier(it->value, dialect);
        if (word != it->value) result.replace(it->start, it->end - it->start, word);
    }
    return result;
}

ЛОГИКА pattern(const std::vector<Token>& sig, size_t i, std::initializer_list<string_view> words) {
    if (i + words.size() > sig.size()) ВЕРНУТЬ ЛОЖЬ;
    size_t k = 0;
    for (auto word : words) if (sig[i + k++].value != word) ВЕРНУТЬ ЛОЖЬ;
    ВЕРНУТЬ ИСТИНА;
}

ЛОГИКА is_io(const std::vector<Token>& sig, size_t i) {
    const string& v = sig[i].value;
    static const std::array<string_view, 12> names = {
        "МОЛИТВА", "printf", "scanf", "puts", "putchar", "getchar", "fprintf",
        "fputs", "fgets", "fopen", "fread", "fwrite"};
    if (std::find(names.begin(), names.end(), v) != names.end()) ВЕРНУТЬ ИСТИНА;
    if (v == "ofstream" || v == "ifstream" || v == "fstream") ВЕРНУТЬ ИСТИНА;
    static const std::array<string_view, 9> std_io = {
        "cout", "cin", "cerr", "clog", "print", "println", "ofstream", "ifstream", "fstream"};
    for (auto name : std_io) if (pattern(sig, i, {"std", ":", ":", name})) ВЕРНУТЬ ИСТИНА;
    ВЕРНУТЬ ЛОЖЬ;
}

ЛОГИКА is_allocation(const string& v) {
    static const std::array<string_view, 10> names = {
        "new", "delete", "НОВОЕ", "УДАЛИТЬ", "malloc", "calloc", "realloc", "free", "make_unique", "make_shared"};
    ВЕРНУТЬ std::find(names.begin(), names.end(), v) != names.end();
}

string masked(const string& src) {
    string masked_text;
    masked_text.reserve(src.size());
    for (unsigned char c : src) {
        if (c == '\n') masked_text += '\n';
        else if ((c & 0xC0) != 0x80) masked_text += ' ';
    }
    ВЕРНУТЬ masked_text;
}

std::vector<Edit> analyze_edits(const string& source, ЛОГИКА dark_age = ЛОЖЬ, const string& dialect = "ru") {
    if (dialect != "ru" && dialect != "high-gothic" && dialect != "gothic")
        throw Heresy("OMN050", "неизвестный диалект: " + dialect);
    if (source.find('\0') != string::npos) throw Heresy("OMN043", "NUL в исходном файле");
    verify_utf8(source);
    const auto tokens = lex(source);
    std::vector<Token> sig;
    for (const auto& t : tokens) {
        if (t.kind != "ws" && t.kind != "comment" && t.kind != "directive") {
            Token effective = t;
            if (t.kind == "identifier") effective.value = canonical_identifier(t.value, dialect);
            sig.push_back(std::move(effective));
        }
    }
    std::vector<Edit> edits;
    std::map<string, Token> rituals;
    ЛОГИКА invoked = ЛОЖЬ, ended = ЛОЖЬ, seen_nonritual = ЛОЖЬ;
    int depth = 0;
    for (size_t i = 0; i < sig.size();) {
        const Token& t = sig[i];
        const string& v = t.value;
        if (v == "ВО_ИМЯ_ОМНИССИИ" || v == "ДА_БУДЕТ_ВОЛЯ_МАШИНЫ" || v == "ОСВЯТИТЬ" || v == "ВОССЛАВИТЬ") {
            if (depth) throw Heresy("OMN012", "ритуал разрешён только на верхнем уровне", t);
            if (v == "ВО_ИМЯ_ОМНИССИИ" || v == "ДА_БУДЕТ_ВОЛЯ_МАШИНЫ") {
                if (i + 1 >= sig.size() || sig[i + 1].value != ";")
                    throw Heresy("OMN013", "после священного маркера нужна точка с запятой", t);
                if (v == "ВО_ИМЯ_ОМНИССИИ") {
                    if (invoked || (seen_nonritual && !dark_age))
                        throw Heresy("OMN001", "призыв Омниссии должен быть первым", t);
                    invoked = ИСТИНА;
                } else {
                    if (ended) throw Heresy("OMN014", "завершение указано дважды", t);
                    ended = ИСТИНА;
                    if (i + 2 < sig.size()) throw Heresy("OMN015", "после завершения не должно быть кода", sig[i + 2]);
                }
                edits.push_back(Edit{t.start, sig[i + 1].end, masked(source.substr(t.start, sig[i + 1].end - t.start))});
                i += 2;
                continue;
            }
            if (i + 2 >= sig.size() || sig[i + 2].value != ";")
                throw Heresy("OMN016", "ритуал имеет форму «ОСВЯТИТЬ память;»", t);
            string kind;
            const string& target = sig[i + 1].value;
            if (v == "ОСВЯТИТЬ" && target == "процессор") kind = "cpu";
            else if (v == "ОСВЯТИТЬ" && target == "память") kind = "memory";
            else if (v == "ВОССЛАВИТЬ" && target == "машинный_дух") kind = "io";
            else throw Heresy("OMN017", "неизвестный ритуал «" + v + " " + target + "»", t);
            if (!invoked && !dark_age) throw Heresy("OMN001", "сначала призови Омниссию", t);
            if (seen_nonritual && !dark_age) throw Heresy("OMN018", "ритуалы должны предшествовать объявлениям и функциям", t);
            rituals[kind] = t;
            edits.push_back(Edit{t.start, sig[i + 2].end, masked(source.substr(t.start, sig[i + 2].end - t.start))});
            i += 3;
            continue;
        }
        if (v == "{") ++depth;
        if (v == "}") --depth;
        if (!invoked && !dark_age) throw Heresy("OMN001", "первая инструкция: ВО_ИМЯ_ОМНИССИИ;", t);
        if (ended) throw Heresy("OMN015", "код после завершения", t);
        if ((v == "главная" || v == "ГЛАВНАЯ" || v == "main") && i + 1 < sig.size() && sig[i + 1].value == "(") {
            if (!rituals.count("cpu") && !dark_age)
                throw Heresy("OMN020", "прежде чем объявить main(), напиши ОСВЯТИТЬ процессор;", t);
        }
        if (is_io(sig, i) && !rituals.count("io") && !dark_age)
            throw Heresy("OMN021", "ввод-вывод требует ВОССЛАВИТЬ машинный_дух;", t);
        if (is_allocation(v) && !rituals.count("memory") && !dark_age)
            throw Heresy("OMN022", "выделение/освобождение памяти требует ОСВЯТИТЬ память;", t);
        auto word = KEYWORDS.find(v);
        if (t.kind == "identifier") {
            if (word != KEYWORDS.end()) edits.push_back(Edit{t.start, t.end, word->second});
            else if (v != source.substr(t.start, t.end - t.start)) edits.push_back(Edit{t.start, t.end, v});
        }
        seen_nonritual = ИСТИНА;
        ++i;
    }
    if (!dark_age) {
        if (!invoked) throw Heresy("OMN001", "отсутствует ВО_ИМЯ_ОМНИССИИ;");
        if (!ended) throw Heresy("OMN019", "отсутствует ДА_БУДЕТ_ВОЛЯ_МАШИНЫ;");
    }
    ВЕРНУТЬ edits;
}

void validate_binary_litany(const string& decoded) {
    // Independently enforce ALL consecrations and an actual prayer call.
    // Comment and string tokens do not count as liturgies.
    std::vector<string> words;
    for (const auto& t : lex(decoded)) {
        if (t.kind == "ws" || t.kind == "comment" || t.kind == "directive") continue;
        words.push_back(t.kind == "identifier" ?
                        canonical_identifier(t.value, "high-gothic") : t.value);
    }
    auto contains = [&words](std::initializer_list<string_view> rite) {
        if (rite.size() > words.size()) return false;
        for (size_t i = 0; i + rite.size() <= words.size(); ++i) {
            bool matches = true;
            size_t j = 0;
            for (auto part : rite) if (words[i + j++] != part) { matches = false; break; }
            if (matches) return true;
        }
        return false;
    };
    if (!contains({"ОСВЯТИТЬ", "процессор", ";"}))
        throw Heresy("OMN063", "Binary Cant требует ОСВЯТИТЬ процессор;");
    if (!contains({"ОСВЯТИТЬ", "память", ";"}))
        throw Heresy("OMN063", "Binary Cant требует ОСВЯТИТЬ память;");
    if (!contains({"ВОССЛАВИТЬ", "машинный_дух", ";"}))
        throw Heresy("OMN063", "Binary Cant требует ВОССЛАВИТЬ машинный_дух;");
    if (!contains({"МОЛИТВА", "("}))
        throw Heresy("OMN063", "Binary Cant требует хотя бы одну МОЛИТВА(...)");
}

string wrap_cpp(const string& translated, const string& filename) {
    string escaped;
    for (char c : filename) {
        if (c == '\\' || c == '\"') escaped += '\\';
        escaped += c == '\n' ? ' ' : c;
    }
    ВЕРНУТЬ RUNTIME + "\n#line 1 \"" + escaped + "\"\n" + translated;
}

string apply_edits(string source, const std::vector<Edit>& edits) {
    for (auto it = edits.rbegin(); it != edits.rend(); ++it)
        source.replace(it->start, it->end - it->start, it->text);
    ВЕРНУТЬ source;
}

string transpile(const string& source, const string& filename, ЛОГИКА dark_age = ЛОЖЬ, const string& dialect = "ru") {
    ВЕРНУТЬ wrap_cpp(apply_edits(source, analyze_edits(source, dark_age, dialect)), filename);
}

string read_file(const fs::path& path) {
    std::ifstream file(path, std::ios::binary);
    if (!file) throw std::runtime_error("невозможно прочитать файл: " + path.string());
    string src((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
    if (starts(src, 0, "\xEF\xBB\xBF")) src.erase(0, 3);
    ВЕРНУТЬ src;
}

НИЧТО write_file(const fs::path& path, const string& data) {
    if (!path.parent_path().empty()) fs::create_directories(path.parent_path());
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file || !(file << data)) throw std::runtime_error("невозможно записать файл: " + path.string());
}

int execute(const std::vector<string>& args) {
#ifdef _WIN32
    (void)args;
    throw std::runtime_error("native build пока поддерживает POSIX; emit/check доступны на Windows");
#else
    if (args.empty()) throw std::runtime_error("нет команды для запуска");
    pid_t pid = fork();
    if (pid < 0) throw std::runtime_error("fork failed");
    if (pid == 0) {
        std::vector<char*> argv;
        for (const auto& a : args) argv.push_back(const_cast<char*>(a.c_str()));
        argv.push_back(nullptr);
        execvp(argv[0], argv.data());
        std::cerr << "execvp failed: " << args[0] << '\n';
        _exit(127);
    }
    int status = 0;
    while (waitpid(pid, &status, 0) == -1) {
        if (errno != EINTR) throw std::runtime_error("waitpid failed");
    }
    if (WIFEXITED(status)) return WEXITSTATUS(status);
    if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);
    return 1;
#endif
}

// R03 core syntax tree: parsed by the self-hosted native compiler, not by Python.
// This is a deliberately restricted grammar, not a pretend full C++ frontend.
struct ASTNode {
    string kind, value;
    int line = 1, column = 1;
    std::vector<ASTNode> children;
};

ASTNode ast_node(const string& kind, const string& value, const Token& at) {
    ВЕРНУТЬ ASTNode{kind, value, at.line, at.column, {}};
}

class CoreParser {
    std::vector<Token> tokens;
    Token eof{"eof", "<eof>", 0, 0, 1, 1};
    size_t pos = 0;
    std::vector<string> classes;

    const Token& peek(size_t skip = 0) const {
        ВЕРНУТЬ pos + skip < tokens.size() ? tokens[pos + skip] : eof;
    }
    ЛОГИКА at(string_view word) const { ВЕРНУТЬ peek().value == word; }
    ЛОГИКА take(string_view word) {
        if (!at(word)) ВЕРНУТЬ ЛОЖЬ;
        ++pos;
        ВЕРНУТЬ ИСТИНА;
    }
    Token next() {
        if (pos >= tokens.size()) throw Heresy("OMN110", "неожиданный конец программы", eof);
        ВЕРНУТЬ tokens[pos++];
    }
    Token expect(string_view word) {
        if (!at(word)) throw Heresy("OMN111", "ожидалось «" + string(word) + "», получено «" + peek().value + "»", peek());
        ВЕРНУТЬ next();
    }
    Token identifier() {
        if (peek().kind != "identifier") throw Heresy("OMN112", "ожидалось имя, получено «" + peek().value + "»", peek());
        ВЕРНУТЬ next();
    }
    ЛОГИКА is_type(const string& word) const {
        static const std::array<string_view, 18> types = {
            "ЦЕЛОЕ", "ДРОБЬ", "СТРОКА", "ЛОГИКА", "НИЧТО", "АВТО",
            "int", "double", "float", "bool", "void", "auto", "char",
            "long", "short", "unsigned", "signed", "size_t"};
        if (std::find(types.begin(), types.end(), word) != types.end()) ВЕРНУТЬ ИСТИНА;
        ВЕРНУТЬ std::find(classes.begin(), classes.end(), word) != classes.end();
    }
    ЛОГИКА declaration_ahead() const {
        if (is_type(peek().value) || at("ПОСТОЯННО") || at("const")) ВЕРНУТЬ ИСТИНА;
        // A user type followed by another identifier is a declaration.
        ВЕРНУТЬ peek().kind == "identifier" && peek(1).kind == "identifier";
    }
    string parse_type() {
        string type;
        if (at("ПОСТОЯННО") || at("const")) type = next().value + " ";
        if (peek().kind != "identifier") throw Heresy("OMN113", "ожидался тип", peek());
        type += next().value;
        while (at(":") && peek(1).value == ":") {
            next(); next();
            type += "::" + identifier().value;
        }
        // Supports simple instantiated types, including nested closing > >.
        if (take("<")) {
            type += "<" + parse_type();
            while (take(",")) type += "," + parse_type();
            expect(">");
            type += ">";
        }
        while (at("*") || at("&")) type += next().value;
        ВЕРНУТЬ type;
    }
    string binary_operator() const {
        string a = peek().value;
        string b = peek(1).value;
        if ((a == "=" || a == "!" || a == "<" || a == ">") && b == "=") ВЕРНУТЬ a + b;
        if ((a == "&" && b == "&") || (a == "|" && b == "|")) ВЕРНУТЬ a + b;
        if ((a == "+" || a == "-" || a == "*" || a == "/" || a == "%") && b == "=") ВЕРНУТЬ a + b;
        if (a == "=" || a == "<" || a == ">" || a == "+" || a == "-" || a == "*" || a == "/" || a == "%") ВЕРНУТЬ a;
        ВЕРНУТЬ "";
    }
    int precedence(const string& op) const {
        if (op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=") ВЕРНУТЬ 1;
        if (op == "||") ВЕРНУТЬ 2;
        if (op == "&&") ВЕРНУТЬ 3;
        if (op == "==" || op == "!=") ВЕРНУТЬ 4;
        if (op == "<" || op == "<=" || op == ">" || op == ">=") ВЕРНУТЬ 5;
        if (op == "+" || op == "-") ВЕРНУТЬ 6;
        if (op == "*" || op == "/" || op == "%") ВЕРНУТЬ 7;
        ВЕРНУТЬ -1;
    }
    ASTNode expression(int minimum = 1) {
        ASTNode left = unary();
        while (ИСТИНА) {
            string op = binary_operator();
            int priority = precedence(op);
            if (priority < minimum) break;
            Token loc = peek();
            pos += op.size();
            ЛОГИКА assign = priority == 1;
            ASTNode right = expression(priority + (assign ? 0 : 1));
            ASTNode result = ast_node("Binary", op, loc);
            result.children.push_back(std::move(left));
            result.children.push_back(std::move(right));
            left = std::move(result);
        }
        if (minimum <= 2 && at("?")) {
            Token loc = next();
            ASTNode middle = expression();
            expect(":");
            ASTNode last = expression(2);
            ASTNode choice = ast_node("Conditional", "?:", loc);
            choice.children.push_back(std::move(left));
            choice.children.push_back(std::move(middle));
            choice.children.push_back(std::move(last));
            left = std::move(choice);
        }
        ВЕРНУТЬ left;
    }
    ASTNode unary() {
        string prefix = peek().value;
        if ((prefix == "+" || prefix == "-") && peek(1).value == prefix) {
            Token loc = next(); next();
            ASTNode n = ast_node("Unary", prefix + prefix, loc);
            n.children.push_back(unary());
            ВЕРНУТЬ n;
        }
        if (prefix == "!" || prefix == "~" || prefix == "-" || prefix == "+" || prefix == "*" || prefix == "&") {
            Token loc = next();
            ASTNode n = ast_node("Unary", prefix, loc);
            n.children.push_back(unary());
            ВЕРНУТЬ n;
        }
        ASTNode left = primary();
        while (ИСТИНА) {
            if (at("(")) {
                Token loc = next();
                ASTNode call = ast_node("Call", "", loc);
                call.children.push_back(std::move(left));
                if (!at(")")) {
                    call.children.push_back(expression());
                    while (take(",")) call.children.push_back(expression());
                }
                expect(")");
                left = std::move(call);
            } else if (at("[")) {
                Token loc = next();
                ASTNode index = ast_node("Index", "", loc);
                index.children.push_back(std::move(left));
                index.children.push_back(expression());
                expect("]");
                left = std::move(index);
            } else if (at(".") || (at("-") && peek(1).value == ">") || (at(":") && peek(1).value == ":")) {
                Token loc = next();
                string op = loc.value;
                if (op == "-" || op == ":") op += next().value;
                ASTNode member = ast_node("Member", op + identifier().value, loc);
                member.children.push_back(std::move(left));
                left = std::move(member);
            } else if ((at("+") || at("-")) && peek(1).value == peek().value) {
                Token loc = next(); next();
                ASTNode post = ast_node("Postfix", loc.value + loc.value, loc);
                post.children.push_back(std::move(left));
                left = std::move(post);
            } else break;
        }
        ВЕРНУТЬ left;
    }
    ASTNode primary() {
        Token loc = peek();
        if (take("(")) {
            ASTNode inside = expression();
            expect(")");
            ВЕРНУТЬ inside;
        }
        if (loc.kind == "number" || loc.kind == "string" || loc.value == "ИСТИНА" || loc.value == "ЛОЖЬ" ||
            loc.value == "true" || loc.value == "false") {
            next();
            ВЕРНУТЬ ast_node("Literal", loc.value, loc);
        }
        if (loc.kind == "identifier") {
            next();
            ВЕРНУТЬ ast_node("Name", loc.value, loc);
        }
        throw Heresy("OMN114", "ожидалось выражение, получено «" + loc.value + "»", loc);
    }
    ASTNode variable(ЛОГИКА semicolon) {
        Token loc = peek();
        string type = parse_type();
        ASTNode declaration = ast_node("VariableDeclaration", type, loc);
        while (ИСТИНА) {
            Token name = identifier();
            ASTNode var = ast_node("Variable", name.value, name);
            if (take("=")) var.children.push_back(expression());
            declaration.children.push_back(std::move(var));
            if (!take(",")) break;
        }
        if (semicolon) expect(";");
        ВЕРНУТЬ declaration;
    }
    ASTNode block() {
        Token loc = expect("{");
        ASTNode n = ast_node("Block", "", loc);
        while (!at("}")) {
            if (peek().kind == "eof") throw Heresy("OMN115", "не закрыт блок {", peek());
            n.children.push_back(statement());
        }
        expect("}");
        ВЕРНУТЬ n;
    }
    ASTNode statement() {
        Token loc = peek();
        if (at("{")) ВЕРНУТЬ block();
        if (take("ЕСЛИ_ВОЛЯ_ОМНИССИИ") || take("if")) {
            ASTNode n = ast_node("If", "", loc);
            expect("("); n.children.push_back(expression()); expect(")");
            n.children.push_back(statement());
            if (take("ИНАЧЕ") || take("else")) n.children.push_back(statement());
            ВЕРНУТЬ n;
        }
        if (take("ПОКА_ДУХ_НЕ_УСМИРЕН") || take("while")) {
            ASTNode n = ast_node("While", "", loc);
            expect("("); n.children.push_back(expression()); expect(")");
            n.children.push_back(statement());
            ВЕРНУТЬ n;
        }
        if (take("СВЯЩЕННЫЙ_ЦИКЛ") || take("for")) {
            ASTNode n = ast_node("For", "", loc);
            expect("(");
            if (at(";")) n.children.push_back(ast_node("Empty", "", peek()));
            else if (declaration_ahead()) n.children.push_back(variable(ЛОЖЬ));
            else n.children.push_back(expression());
            expect(";");
            if (at(";")) n.children.push_back(ast_node("Empty", "", peek()));
            else n.children.push_back(expression());
            expect(";");
            if (at(")")) n.children.push_back(ast_node("Empty", "", peek()));
            else n.children.push_back(expression());
            expect(")"); n.children.push_back(statement());
            ВЕРНУТЬ n;
        }
        if (take("ВЕРНУТЬ") || take("return")) {
            ASTNode n = ast_node("Return", "", loc);
            if (!at(";")) n.children.push_back(expression());
            expect(";");
            ВЕРНУТЬ n;
        }
        if (take("ПРЕРВАТЬ") || take("break")) { expect(";"); ВЕРНУТЬ ast_node("Break", "", loc); }
        if (take("ПРОДОЛЖИТЬ") || take("continue")) { expect(";"); ВЕРНУТЬ ast_node("Continue", "", loc); }
        if (take(";")) ВЕРНУТЬ ast_node("Empty", "", loc);
        if (declaration_ahead()) ВЕРНУТЬ variable(ИСТИНА);
        ASTNode result = ast_node("ExpressionStatement", "", loc);
        result.children.push_back(expression());
        expect(";");
        ВЕРНУТЬ result;
    }
    ASTNode declaration() {
        Token loc = peek();
        if (take("КЛАСС") || take("class") || take("СТРУКТУРА") || take("struct")) {
            Token name = identifier();
            classes.push_back(name.value);
            ASTNode n = ast_node((loc.value == "СТРУКТУРА" || loc.value == "struct") ? "Struct" : "Class", name.value, loc);
            expect("{");
            while (!at("}")) {
                if (peek().kind == "eof") throw Heresy("OMN115", "не закрыто тело класса", peek());
                if (at("ПУБЛИЧНО") || at("ЧАСТНО") || at("ЗАЩИЩЕНО") ||
                    at("public") || at("private") || at("protected")) {
                    Token access = next(); expect(":");
                    n.children.push_back(ast_node("Access", access.value, access));
                } else n.children.push_back(declaration());
            }
            expect("}"); expect(";");
            ВЕРНУТЬ n;
        }
        string type = parse_type();
        Token name = identifier();
        if (take("(")) {
            ASTNode n = ast_node("Function", name.value, loc);
            n.children.push_back(ast_node("ReturnType", type, loc));
            if (!at(")")) {
                while (ИСТИНА) {
                    Token arg_start = peek();
                    string arg_type = parse_type();
                    Token arg_name = identifier();
                    n.children.push_back(ast_node("Parameter", arg_type + " " + arg_name.value, arg_start));
                    if (!take(",")) break;
                }
            }
            expect(")");
            if (take(";")) ВЕРНУТЬ n;
            n.children.push_back(block());
            ВЕРНУТЬ n;
        }
        ASTNode n = ast_node("VariableDeclaration", type, loc);
        ASTNode var = ast_node("Variable", name.value, name);
        if (take("=")) var.children.push_back(expression());
        n.children.push_back(std::move(var));
        while (take(",")) {
            Token other = identifier();
            ASTNode v = ast_node("Variable", other.value, other);
            if (take("=")) v.children.push_back(expression());
            n.children.push_back(std::move(v));
        }
        expect(";");
        ВЕРНУТЬ n;
    }

public:
    explicit CoreParser(const string& src) {
        for (const auto& t : lex(src))
            if (t.kind != "ws" && t.kind != "comment" && t.kind != "directive") tokens.push_back(t);
        if (!tokens.empty()) {
            eof.line = tokens.back().line;
            eof.column = tokens.back().column + int(tokens.back().value.size());
            eof.start = eof.end = tokens.back().end;
        }
    }
    ASTNode program() {
        ASTNode root{"Program", "Omnissiah++ core R03", 1, 1, {}};
        while (peek().kind != "eof") {
            Token loc = peek();
            if (at("ВО_ИМЯ_ОМНИССИИ") || at("ДА_БУДЕТ_ВОЛЯ_МАШИНЫ")) {
                root.children.push_back(ast_node("Ritual", next().value, loc));
                expect(";");
            } else if (at("ОСВЯТИТЬ") || at("ВОССЛАВИТЬ")) {
                string action = next().value;
                string target = identifier().value;
                root.children.push_back(ast_node("Ritual", action + " " + target, loc));
                expect(";");
            } else root.children.push_back(declaration());
        }
        ВЕРНУТЬ root;
    }
};

string json_quote(const string& value) {
    const char* digits = "0123456789abcdef";
    string out = "\"";
    for (unsigned char c : value) {
        if (c == '"' || c == '\\') { out += '\\'; out += char(c); }
        else if (c == '\n') out += "\\n";
        else if (c == '\r') out += "\\r";
        else if (c == '\t') out += "\\t";
        else if (c < 0x20) { out += "\\u00"; out += digits[c >> 4]; out += digits[c & 15]; }
        else out += char(c);
    }
    ВЕРНУТЬ out + "\"";
}

НИЧТО append_json(const ASTNode& tree, string& result) {
    result += "{\"kind\":" + json_quote(tree.kind) + ",\"value\":" + json_quote(tree.value);
    result += ",\"line\":" + std::to_string(tree.line) + ",\"column\":" + std::to_string(tree.column);
    result += ",\"children\":[";
    ЛОГИКА first = ИСТИНА;
    for (const auto& child : tree.children) {
        if (!first) result += ',';
        first = ЛОЖЬ;
        append_json(child, result);
    }
    result += "]}";
}

string ast_json(const string& source) {
    CoreParser parser(source);
    string result;
    ASTNode root = parser.program();
    append_json(root, result);
    ВЕРНУТЬ result + "\n";
}

// R03 core code generator: consumes AST (not text-substituted source).
string canonical_type(const string& type) {
    string out;
    for (const auto& tok : lex(type)) {
        auto found = KEYWORDS.find(tok.value);
        out += tok.kind == "identifier" && found != KEYWORDS.end() ? found->second : tok.value;
    }
    ВЕРНУТЬ out;
}

string canonical_name(const string& name) {
    auto it = KEYWORDS.find(name);
    ВЕРНУТЬ it != KEYWORDS.end() ? it->second : name;
}

string emit_core_expr(const ASTNode& n) {
    if (n.kind == "Name") ВЕРНУТЬ canonical_name(n.value);
    if (n.kind == "Literal") {
        if (n.value == "ИСТИНА") ВЕРНУТЬ "true";
        if (n.value == "ЛОЖЬ") ВЕРНУТЬ "false";
        ВЕРНУТЬ n.value;
    }
    if (n.kind == "Binary")
        ВЕРНУТЬ "(" + emit_core_expr(n.children.at(0)) + " " + n.value + " " + emit_core_expr(n.children.at(1)) + ")";
    if (n.kind == "Conditional")
        ВЕРНУТЬ "(" + emit_core_expr(n.children.at(0)) + " ? " + emit_core_expr(n.children.at(1)) + " : " + emit_core_expr(n.children.at(2)) + ")";
    if (n.kind == "Unary") ВЕРНУТЬ "(" + n.value + emit_core_expr(n.children.at(0)) + ")";
    if (n.kind == "Postfix") ВЕРНУТЬ "(" + emit_core_expr(n.children.at(0)) + n.value + ")";
    if (n.kind == "Member") {
        string op = n.value.substr(0, 1);
        if (n.value.rfind("->", 0) == 0 || n.value.rfind("::", 0) == 0) op = n.value.substr(0, 2);
        string base = emit_core_expr(n.children.at(0));
        ВЕРНУТЬ (op == "::" ? base : "(" + base + ")") + op + canonical_name(n.value.substr(op.size()));
    }
    if (n.kind == "Index") ВЕРНУТЬ emit_core_expr(n.children.at(0)) + "[" + emit_core_expr(n.children.at(1)) + "]";
    if (n.kind == "Call") {
        string out = emit_core_expr(n.children.at(0)) + "(";
        for (size_t i = 1; i < n.children.size(); ++i) {
            if (i != 1) out += ", ";
            out += emit_core_expr(n.children.at(i));
        }
        ВЕРНУТЬ out + ")";
    }
    throw std::runtime_error("неизвестный AST-узел выражения: " + n.kind);
}

string emit_core_decl(const ASTNode& n, ЛОГИКА semicolon = ИСТИНА) {
    string out = canonical_type(n.value) + " ";
    for (size_t i = 0; i < n.children.size(); ++i) {
        if (i) out += ", ";
        const auto& var = n.children[i];
        out += canonical_name(var.value);
        if (!var.children.empty()) out += " = " + emit_core_expr(var.children[0]);
    }
    ВЕРНУТЬ out + (semicolon ? ";" : "");
}

string emit_core_stmt(const ASTNode& n);
string emit_core_stmt(const ASTNode& n) {
    if (n.kind == "VariableDeclaration") ВЕРНУТЬ emit_core_decl(n);
    if (n.kind == "Block") {
        string out = "{\n";
        for (const auto& child : n.children) out += emit_core_stmt(child) + "\n";
        ВЕРНУТЬ out + "}";
    }
    if (n.kind == "Return") ВЕРНУТЬ "return" + (n.children.empty() ? string("") : " " + emit_core_expr(n.children[0])) + ";";
    if (n.kind == "Break") ВЕРНУТЬ "break;";
    if (n.kind == "Continue") ВЕРНУТЬ "continue;";
    if (n.kind == "Empty") ВЕРНУТЬ ";";
    if (n.kind == "ExpressionStatement") ВЕРНУТЬ emit_core_expr(n.children.at(0)) + ";";
    if (n.kind == "If") {
        string out = "if (" + emit_core_expr(n.children.at(0)) + ") " + emit_core_stmt(n.children.at(1));
        if (n.children.size() > 2) out += " else " + emit_core_stmt(n.children[2]);
        ВЕРНУТЬ out;
    }
    if (n.kind == "While") ВЕРНУТЬ "while (" + emit_core_expr(n.children.at(0)) + ") " + emit_core_stmt(n.children.at(1));
    if (n.kind == "For") {
        const auto& init = n.children.at(0);
        string a = init.kind == "Empty" ? "" : (init.kind == "VariableDeclaration" ? emit_core_decl(init, ЛОЖЬ) : emit_core_expr(init));
        string b = n.children[1].kind == "Empty" ? "" : emit_core_expr(n.children[1]);
        string c = n.children[2].kind == "Empty" ? "" : emit_core_expr(n.children[2]);
        ВЕРНУТЬ "for (" + a + "; " + b + "; " + c + ") " + emit_core_stmt(n.children.at(3));
    }
    if (n.kind == "Function") {
        string out = canonical_type(n.children.at(0).value) + " " + canonical_name(n.value) + "(";
        for (size_t i = 1; i < n.children.size(); ++i) {
            const auto& param = n.children[i];
            if (param.kind != "Parameter") break;
            if (i > 1) out += ", ";
            // The parameter value stores its type and name separated by the last space.
            size_t split = param.value.rfind(' ');
            out += canonical_type(param.value.substr(0, split)) + " " + canonical_name(param.value.substr(split + 1));
        }
        out += ")";
        if (!n.children.empty() && n.children.back().kind == "Block") out += " " + emit_core_stmt(n.children.back());
        else out += ";";
        ВЕРНУТЬ out;
    }
    if (n.kind == "Access") ВЕРНУТЬ canonical_name(n.value) + ":";
    if (n.kind == "Struct" || n.kind == "Class") {
        string out = (n.kind == "Class" ? "class " : "struct ") + n.value + " {\n";
        for (const auto& child : n.children) out += emit_core_stmt(child) + "\n";
        ВЕРНУТЬ out + "};";
    }
    if (n.kind == "Ritual") ВЕРНУТЬ "";
    throw std::runtime_error("неизвестный AST-узел: " + n.kind);
}

string emit_core_cpp(const string& source, const string& filename) {
    CoreParser parser(source);
    ASTNode root = parser.program();
    string headers;
    for (const auto& t : lex(source)) {
        if (t.kind == "directive") {
            string value = t.value;
            size_t i = value.find_first_not_of(" \t\r");
            if (i == string::npos || value.compare(i, 8, "#include") != 0)
                throw Heresy("OMN116", "core-emit поддерживает только директивы #include", t);
            headers += value;
            if (headers.back() != '\n') headers += '\n';
        }
    }
    string out = RUNTIME + "\n" + headers;
    // Report diagnostics at the original source file whenever C++ rejects the result.
    string escaped;
    for (char c : filename) {
        if (c == '\\' || c == '"') escaped += '\\';
        escaped += c == '\n' ? ' ' : c;
    }
    out += "#line 1 \"" + escaped + "\"\n";
    for (const auto& child : root.children) {
        if (child.kind != "Ritual") out += emit_core_stmt(child) + "\n";
    }
    ВЕРНУТЬ out;
}

// R04 lossless structural syntax tree. Unlike the restricted R03 CoreParser,
// this frontend accepts the whole native compiler source, including templates,
// lambdas, initializers, namespaces, conditional preprocessor directives, and
// raw strings. It validates (), [] and {} nesting and preserves every byte.
// It is NOT yet a full grammar/semantic parser for C++20.
struct SourceNode {
    string kind;
    Token open;
    Token close;
    std::vector<SourceNode> children;
    string role;
    string function_name;
    string return_type;
    std::vector<std::pair<string, string>> parameters;
    std::vector<std::pair<size_t, size_t>> parameter_spans;
    std::vector<std::pair<size_t, size_t>> parameter_type_spans;
    std::vector<std::pair<size_t, size_t>> parameter_name_spans;
};

class SourceParser {
    std::vector<Token> tokens;
    size_t pos = 0;
    Token eof{"eof", "<eof>", 0, 0, 1, 1};

    static string matching(string_view symbol) {
        if (symbol == "(") ВЕРНУТЬ ")";
        if (symbol == "[") ВЕРНУТЬ "]";
        if (symbol == "{") ВЕРНУТЬ "}";
        ВЕРНУТЬ "";
    }

    // R05: grammar-aware labels for brace bodies. This deliberately uses only
    // unambiguous declaration prefixes; ambiguous braces stay structural.
    static string brace_role(const std::vector<SourceNode>& siblings) {
        std::vector<string> words;
        for (size_t i = siblings.size(); i > 0 && words.size() < 32; --i) {
            const SourceNode& n = siblings[i - 1];
            if (n.open.kind == "comment" || n.open.kind == "ws" ||
                n.open.kind == "directive") continue;
            if (n.open.value == ";" || n.open.value == "}" || n.open.value == "{") break;
            words.push_back(n.open.value);
        }
        std::reverse(words.begin(), words.end());
        // A 'class' inside template<class T> belongs to the template
        // parameter list, not to the declaration whose body follows.
        // Require a declaration-leading keyword instead of searching every
        // word in the header (which also mislabels function bodies).
        size_t declaration = 0;
        if (!words.empty() && (words[0] == "inline" || words[0] == "ИНЛАЙН"))
            declaration = 1;
        if (declaration < words.size()) {
            const string& first = words[declaration];
            if (first == "namespace" || first == "ПРОСТРАНСТВО")
                ВЕРНУТЬ "NamespaceBody";
            if (first == "class" || first == "КЛАСС" ||
                first == "struct" || first == "СТРУКТУРА" ||
                first == "union")
                ВЕРНУТЬ "TypeBody";
            if (first == "enum" && declaration + 1 < words.size() &&
                (words[declaration + 1] == "class" ||
                 words[declaration + 1] == "struct"))
                ВЕРНУТЬ "TypeBody";
        }
        // A parenthesized header can be a control statement or a callable.
        // Inspect only significant siblings in the current statement; tokens
        // inside strings/comments and preceding statements must not count.
        std::vector<const SourceNode*> header;
        for (size_t i = siblings.size(); i > 0 && header.size() < 64; --i) {
            const SourceNode& n = siblings[i - 1];
            if (n.open.kind == "ws" || n.open.kind == "comment" ||
                n.open.kind == "directive") continue;
            if (n.open.value == ";" || n.open.value == "}" || n.open.value == "{") break;
            header.push_back(&n);
        }
        std::reverse(header.begin(), header.end());
        if (!header.empty()) {
            const string& first = header.front()->open.value;
            if (first == "else" || first == "ИНАЧЕ" || first == "do")
                ВЕРНУТЬ "ControlBody";
            const SourceNode& last = *header.back();
            if (last.kind == "Group" && last.open.value == "(") {
                for (const auto* node : header) {
                    const string& word = node->open.value;
                    if (word == "if" || word == "ЕСЛИ_ВОЛЯ_ОМНИССИИ" ||
                        word == "for" || word == "СВЯЩЕННЫЙ_ЦИКЛ" ||
                        word == "while" || word == "ПОКА_ДУХ_НЕ_УСМИРЕН" ||
                        word == "switch" || word == "catch")
                        ВЕРНУТЬ "ControlBody";
                }
                // Recognize only unambiguous simple function definitions.
                // Lambdas, constructors and complex declarators remain ambiguous.
                // Header shape: <return-type> <name> (<parameters>) { ... }
                if (header.size() >= 3) {
                    const SourceNode& name = *header[header.size() - 2];
                    const SourceNode& type = *header[header.size() - 3];
                    if (name.open.kind == "identifier" &&
                        type.open.kind == "identifier" &&
                        name.open.value != "operator" &&
                        type.open.value != "return" &&
                        type.open.value != "ВЕРНУТЬ" &&
                        type.open.value != "new" &&
                        type.open.value != "НОВОЕ" &&
                        type.open.value != "delete" &&
                        type.open.value != "УДАЛИТЬ" &&
                        type.open.value != "co_return" &&
                        type.open.value != "throw")
                        ВЕРНУТЬ "FunctionBody";
                }
                ВЕРНУТЬ "CallableOrControlBody";
            }
        }
        ВЕРНУТЬ "UnclassifiedBody";
    }

    SourceNode group(const Token& begin, string_view expected, size_t depth) {
        if (depth > 512) throw Heresy("OMN132", "слишком глубокая вложенность разделителей", begin);
        SourceNode out{"Group", begin, begin, {}};
        while (pos < tokens.size()) {
            Token token = tokens[pos++];
            if (token.value == expected && !expected.empty()) {
                out.close = token;
                ВЕРНУТЬ out;
            }
            if (token.kind == "punct" &&
                (token.value == ")" || token.value == "]" || token.value == "}"))
                throw Heresy("OMN131", "неожиданный закрывающий разделитель «" + token.value + "»", token);
            string close = token.kind == "punct" ? matching(token.value) : "";
            if (!close.empty()) {
                string role = token.value == "{" ? brace_role(out.children) : "";
                SourceNode child = group(token, close, depth + 1);
                child.role = role;
                // R05: annotate conservative simple function definitions.
                // More complex C++ declarators remain structural and untyped.
                if (role == "FunctionBody") {
                    std::vector<const SourceNode*> header;
                    for (size_t i = out.children.size(); i > 0 && header.size() < 64; --i) {
                        const SourceNode& n = out.children[i - 1];
                        if (n.open.kind == "ws" || n.open.kind == "comment" ||
                            n.open.kind == "directive") continue;
                        if (n.open.value == ";" || n.open.value == "}" || n.open.value == "{") break;
                        header.push_back(&n);
                    }
                    if (header.size() >= 3) {
                        const SourceNode& name = *header[1];
                        const SourceNode& type = *header[2];
                        if (name.open.kind == "identifier" && type.open.kind == "identifier") {
                            child.function_name = name.open.value;
                            child.return_type = type.open.value;
                            // Recognize conservative built-in qualified declarators.
                            // Unsupported grammar must not produce partial metadata.
                            const SourceNode& args = *header[0];
                            if (args.kind == "Group" && args.open.value == "(") {
                                std::vector<const SourceNode*> part;
                                ЛОГИКА valid = ИСТИНА;
                                auto record_parameter = [&child](const std::vector<const SourceNode*>& p) {
                                    if (p.size() < 2 || p.back()->open.kind != "identifier")
                                        ВЕРНУТЬ ЛОЖЬ;
                                    size_t i = 0;
                                    string type_name;
                                    if (p[i]->open.value == "const" || p[i]->open.value == "ПОСТОЯННО") {
                                        type_name = p[i++]->open.value + " ";
                                    }
                                    if (i >= p.size() - 1 || p[i]->open.kind != "identifier")
                                        ВЕРНУТЬ ЛОЖЬ;
                                    type_name += p[i++]->open.value;
                                    if (i < p.size() - 1 && (p[i]->open.value == "*" || p[i]->open.value == "&")) {
                                        type_name += p[i++]->open.value;
                                        // Lexer emits && as two punctuation tokens.
                                        if (i < p.size() - 1 && p[i - 1]->open.value == "&" &&
                                            p[i]->open.value == "&") type_name += p[i++]->open.value;
                                    }
                                    if (i != p.size() - 1) ВЕРНУТЬ ЛОЖЬ;
                                    child.parameters.push_back({type_name, p.back()->open.value});
                                    child.parameter_spans.push_back({p.front()->open.start, p.back()->open.end});
                                    child.parameter_type_spans.push_back({p.front()->open.start, p[p.size() - 2]->open.end});
                                    child.parameter_name_spans.push_back({p.back()->open.start, p.back()->open.end});
                                    ВЕРНУТЬ ИСТИНА;
                                };
                                for (const auto& item : args.children) {
                                    if (item.open.kind == "ws" || item.open.kind == "comment") continue;
                                    if (item.open.value == ",") {
                                        if (!record_parameter(part)) { valid = ЛОЖЬ; break; }
                                        part.clear();
                                    } else part.push_back(&item);
                                }
                                if (valid && !part.empty()) {
                                    if (!(part.size() == 1 && part[0]->open.value == "void") &&
                                        !record_parameter(part)) valid = ЛОЖЬ;
                                } else if (valid && !args.children.empty() && part.empty()) {
                                    valid = ЛОЖЬ; // trailing comma
                                }
                                if (!valid) {
                                    child.parameters.clear();
                                    child.parameter_spans.clear();
                                    child.parameter_type_spans.clear();
                                    child.parameter_name_spans.clear();
                                }
                            }
                        }
                    }
                }
                out.children.push_back(std::move(child));
            } else out.children.push_back(SourceNode{token.kind, token, token, {}});
        }
        if (!expected.empty())
            throw Heresy("OMN130", "не закрыт разделитель «" + begin.value + "», ожидалось «" + string(expected) + "»", begin);
        out.close = eof;
        ВЕРНУТЬ out;
    }

public:
    explicit SourceParser(const string& source) : tokens(lex(source)) {
        eof.start = eof.end = source.size();
        if (!tokens.empty()) {
            eof.line = tokens.back().line;
            eof.column = tokens.back().column;
        }
    }
    SourceNode program() {
        ВЕРНУТЬ group(Token{"translation_unit", "", 0, 0, 1, 1}, "", 0);
    }
};

НИЧТО append_source_text(const SourceNode& node, string& out) {
    if (node.open.kind != "translation_unit") out += node.open.value;
    for (const auto& child : node.children) append_source_text(child, out);
    if (node.kind == "Group" && node.open.kind != "translation_unit") out += node.close.value;
}

НИЧТО append_source_json(const SourceNode& node, string& out) {
    out += "{\"kind\":" + json_quote(node.open.kind == "translation_unit" ? string("TranslationUnit") : node.kind);
    out += ",\"value\":" + json_quote(node.open.value);
    out += ",\"start\":" + std::to_string(node.open.start);
    size_t end = node.open.kind == "translation_unit" ? node.close.end :
        (node.kind == "Group" ? node.close.end : node.open.end);
    out += ",\"end\":" + std::to_string(end);
    out += ",\"line\":" + std::to_string(node.open.line);
    out += ",\"column\":" + std::to_string(node.open.column);
    if (node.kind == "Group") {
        out += ",\"close\":" + json_quote(node.close.value);
        if (!node.role.empty()) out += ",\"role\":" + json_quote(node.role);
        if (!node.function_name.empty()) {
            out += ",\"function_name\":" + json_quote(node.function_name);
            out += ",\"return_type\":" + json_quote(node.return_type);
            out += ",\"parameters\":[";
            ЛОГИКА first_parameter = ИСТИНА;
            for (const auto& parameter : node.parameters) {
                if (!first_parameter) out += ',';
                first_parameter = ЛОЖЬ;
                out += "{\"type\":" + json_quote(parameter.first) +
                       ",\"name\":" + json_quote(parameter.second) + "}";
            }
            out += "]";
            out += ",\"parameter_spans\":[";
            for (size_t i = 0; i < node.parameter_spans.size(); ++i) {
                if (i) out += ',';
                out += "{\"start\":" + std::to_string(node.parameter_spans[i].first) +
                       ",\"end\":" + std::to_string(node.parameter_spans[i].second) + "}";
            }
            out += "]";
            auto emit_spans = [&out](const string& key, const std::vector<std::pair<size_t, size_t>>& spans) {
                out += "," + json_quote(key) + ":[";
                for (size_t i = 0; i < spans.size(); ++i) {
                    if (i) out += ',';
                    out += "{\"start\":" + std::to_string(spans[i].first) +
                           ",\"end\":" + std::to_string(spans[i].second) + "}";
                }
                out += "]";
            };
            emit_spans("parameter_type_spans", node.parameter_type_spans);
            emit_spans("parameter_name_spans", node.parameter_name_spans);
        }
    }
    out += ",\"children\":[";
    ЛОГИКА first = ИСТИНА;
    for (const auto& child : node.children) {
        if (!first) out += ',';
        first = ЛОЖЬ;
        append_source_json(child, out);
    }
    out += "]}";
}

string source_ast_json(const string& source) {
    SourceParser parser(source);
    SourceNode tree = parser.program();
    tree.close.end = source.size();
    string out;
    append_source_json(tree, out);
    ВЕРНУТЬ out + "\n";
}

string emit_source_cpp(const string& source, const string& filename, ЛОГИКА dark_age = ЛОЖЬ, const string& dialect = "ru") {
    // Keep ritual enforcement shared, but reconstruct the source from the
    // recursive AST rather than using the original input as the output buffer.
    const auto edits = analyze_edits(source, dark_age, dialect);
    SourceParser parser(source);
    SourceNode tree = parser.program();
    string rebuilt;
    rebuilt.reserve(source.size());
    append_source_text(tree, rebuilt);
    if (rebuilt != source) throw Heresy("OMN133", "структурное дерево потеряло часть исходника");
    ВЕРНУТЬ wrap_cpp(apply_edits(std::move(rebuilt), edits), filename);
}

struct Options {
    string action, source, output, cxx = "g++", std_flag = "c++20", optimize = "-O2", keep_cpp, dialect = "ru";
    std::vector<string> run_args;
    ЛОГИКА dark_age = ЛОЖЬ;
};

Options parse_args(int argc, char** argv) {
    if (argc == 2 && string(argv[1]) == "--version") {
        std::cout << "Omnissiah++ native R04 (self-hosting + source AST)\n";
        std::exit(0);
    }
    if (argc < 3) throw std::runtime_error("использование: omnic <check|ast|source-ast|source-emit|source-build|source-run|core-emit|core-build|core-run|emit|build|run> file.omn [-o file] [--dark-age] [--cxx g++]");
    Options opts;
    opts.action = argv[1];
    opts.source = argv[2];
    if (opts.action != "check" && opts.action != "source-ast" && opts.action != "source-emit" && opts.action != "source-build" && opts.action != "source-run" && opts.action != "ast" && opts.action != "core-emit" && opts.action != "core-build" && opts.action != "core-run" && opts.action != "emit" && opts.action != "build" && opts.action != "run")
        throw std::runtime_error("неизвестная команда: " + opts.action);
    for (int i = 3; i < argc; ++i) {
        string a = argv[i];
        if (a == "--dark-age") opts.dark_age = ИСТИНА;
        else if (a == "--dialect") {
            if (++i >= argc) throw std::runtime_error("требуется имя диалекта");
            opts.dialect = argv[i];
        } else if (a.rfind("--dialect=", 0) == 0) {
            opts.dialect = a.substr(string("--dialect=").size());
        }
        else if (a == "-o" || a == "--output") {
            if (++i >= argc) throw std::runtime_error("требуется аргумент после -o");
            opts.output = argv[i];
        } else if (a == "--cxx") {
            if (++i >= argc) throw std::runtime_error("требуется имя компилятора");
            opts.cxx = argv[i];
        } else if (a == "--std") {
            if (++i >= argc) throw std::runtime_error("требуется стандарт C++");
            opts.std_flag = argv[i];
        } else if (a == "--optimize") {
            if (++i >= argc) throw std::runtime_error("требуется уровень оптимизации");
            opts.optimize = argv[i];
        } else if (a.rfind("--optimize=", 0) == 0) {
            opts.optimize = a.substr(string("--optimize=").size());
        } else if (a == "--keep-cpp") {
            if (++i >= argc) throw std::runtime_error("требуется путь C++ файла");
            opts.keep_cpp = argv[i];
        } else if (a == "--arg") {
            if (++i >= argc) throw std::runtime_error("требуется аргумент программы");
            opts.run_args.push_back(argv[i]);
        } else throw std::runtime_error("неизвестный аргумент: " + a);
    }
    if (opts.dialect != "ru" && opts.dialect != "high-gothic" && opts.dialect != "gothic" && opts.dialect != "binary-cant")
        throw std::runtime_error("диалект: ru, high-gothic, gothic или binary-cant");
    if (opts.std_flag != "c++17" && opts.std_flag != "c++20" && opts.std_flag != "c++23")
        throw std::runtime_error("поддерживаются c++17, c++20, c++23");
    if (opts.optimize != "-O0" && opts.optimize != "-O1" && opts.optimize != "-O2" &&
        opts.optimize != "-O3" && opts.optimize != "-Os")
        throw std::runtime_error("неподдерживаемый уровень оптимизации");
    ВЕРНУТЬ opts;
}

// A private scratch directory avoids predictable names and races in /tmp.
struct Scratch {
    fs::path directory;
    Scratch() {
#ifndef _WIN32
        string pattern = (fs::temp_directory_path() / "omnissiah-XXXXXX").string();
        std::vector<char> writable(pattern.begin(), pattern.end());
        writable.push_back('\0');
        char* made = mkdtemp(writable.data());
        if (!made) throw std::runtime_error("mkdtemp failed");
        directory = made;
#else
        throw std::runtime_error("native build пока поддерживает POSIX; emit/check доступны на Windows");
#endif
    }
    ~Scratch() {
        std::error_code ignored;
        fs::remove_all(directory, ignored);
    }
};

int run(const Options& opt) {
    fs::path absolute = fs::absolute(opt.source);
    string source = read_file(opt.source);
    const bool binary_cant = opt.dialect == "binary-cant";
    if (binary_cant && opt.dark_age)
        throw Heresy("OMN064", "Binary Cant запрещает Тёмную эру: молитвы обязательны");
    if (binary_cant) source = decode_binary_cant(source);
    const string effective_dialect = binary_cant ? "high-gothic" : opt.dialect;
    string translated = transpile(source, absolute.lexically_normal().string(), opt.dark_age, effective_dialect);
    if (binary_cant) validate_binary_litany(source);
    if (opt.dark_age) std::cerr << "⚠ ТЁМНАЯ ЭРА ТЕХНОЛОГИЙ: проверки ритуалов отключены.\n";
    if (opt.action == "source-ast") {
        string json = source_ast_json(source);
        if (opt.output.empty()) std::cout << json;
        else write_file(opt.output, json);
        ВЕРНУТЬ 0;
    }
    if (opt.action == "source-emit" || opt.action == "source-build" || opt.action == "source-run") {
        translated = emit_source_cpp(source, absolute.lexically_normal().string(), opt.dark_age, effective_dialect);
        if (opt.action == "source-emit") {
            if (opt.output.empty()) std::cout << translated;
            else write_file(opt.output, translated);
            ВЕРНУТЬ 0;
        }
    }
    if (opt.action == "ast") {
        string json = ast_json(canonical_core_source(source, effective_dialect));
        if (opt.output.empty()) std::cout << json;
        else write_file(opt.output, json);
        ВЕРНУТЬ 0;
    }
    if (opt.action == "core-emit" || opt.action == "core-build" || opt.action == "core-run") {
        translated = emit_core_cpp(canonical_core_source(source, effective_dialect), absolute.lexically_normal().string());
        if (opt.action == "core-emit") {
            if (opt.output.empty()) std::cout << translated;
            else write_file(opt.output, translated);
            ВЕРНУТЬ 0;
        }
    }
    if (opt.action == "check") {
        std::cout << "Омниссия благословил синтаксис: " << opt.source << " (ритуалы проверены)\n";
        ВЕРНУТЬ 0;
    }
    if (opt.action == "emit") {
        if (opt.output.empty()) std::cout << translated;
        else write_file(opt.output, translated);
        ВЕРНУТЬ 0;
    }
    Scratch scratch;
    fs::path cpp = scratch.directory / "translation.cpp";
    fs::path out = opt.output.empty() ? fs::path(opt.source).replace_extension("") : fs::path(opt.output);
    if (opt.action == "run" || opt.action == "source-run" || opt.action == "core-run") out = scratch.directory / "ritual";
    write_file(cpp, translated);
    if (!opt.keep_cpp.empty()) write_file(opt.keep_cpp, translated);
    if (!out.parent_path().empty()) fs::create_directories(out.parent_path());
    int rc = execute({opt.cxx, "-std=" + opt.std_flag, opt.optimize, "-Wall", "-Wextra", "-pedantic", cpp.string(), "-o", out.string()});
    if (rc) ВЕРНУТЬ rc;
    if (opt.action == "build" || opt.action == "source-build" || opt.action == "core-build") {
        std::cout << "Компиляция завершена: " << out.string() << '\n';
        ВЕРНУТЬ 0;
    }
    std::vector<string> cmd{fs::absolute(out).string()};
    cmd.insert(cmd.end(), opt.run_args.begin(), opt.run_args.end());
    ВЕРНУТЬ execute(cmd);
}

} // namespace omni_native

ЛИТАНИЯ главная(int argc, char** argv) {
    try {
        ВЕРНУТЬ omni_native::run(omni_native::parse_args(argc, argv));
    } catch (const omni_native::Heresy& err) {
        std::cerr << err.format(argc > 2 ? argv[2] : "<input>") << '\n';
        ВЕРНУТЬ 2;
    } catch (const std::exception& err) {
        std::cerr << "Ошибка: " << err.what() << '\n';
        ВЕРНУТЬ 3;
    }
}
ДА_БУДЕТ_ВОЛЯ_МАШИНЫ;
