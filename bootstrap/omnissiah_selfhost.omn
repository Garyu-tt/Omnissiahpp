    {"ЛИТАНИЯ", "int"}, {"главная", "main"}, {"ГЛАВНАЯ", "main"},
    {"ЦЕЛОЕ", "int"}, {"ДРОБЬ", "double"}, {"СТРОКА", "std::string"},
    {"ЛОГИКА", "bool"}, {"ИСТИНА", "true"}, {"ЛОЖЬ", "false"},
    {"НИЧТО", "void"}, {"АВТО", "auto"}, {"ПОСТОЯННО", "const"},
    {"ЕСЛИ_ВОЛЯ_ОМНИССИИ", "if"}, {"ИНАЧЕ", "else"},
    {"ПОКА_ДУХ_НЕ_УСМИРЕН", "while"}, {"СВЯЩЕННЫЙ_ЦИКЛ", "for"},
    {"ВЕРНУТЬ", "return"}, {"ПРЕРВАТЬ", "break"}, {"ПРОДОЛЖИТЬ", "continue"},
    {"КЛАСС", "class"}, {"СТРУКТУРА", "struct"}, {"ШАБЛОН", "template"},
    {"ПУБЛИЧНО", "public"}, {"ЧАСТНО", "private"}, {"ЗАЩИЩЕНО", "protected"},
    {"НОВОЕ", "new"}, {"УДАЛИТЬ", "delete"}, {"ПРОСТРАНСТВО", "namespace"},
    {"ИСПОЛЬЗОВАТЬ", "using"}, {"МОЛИТВА", "omni::prayer"},
};

ЛОГИКА ascii_alpha(unsigned char c) { ВЕРНУТЬ (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
ЛОГИКА ascii_digit(unsigned char c) { ВЕРНУТЬ c >= '0' && c <= '9'; }
ЛОГИКА ident_start(unsigned char c) { ВЕРНУТЬ ascii_alpha(c) || c == '_' || c >= 0x80; }
ЛОГИКА ident_rest(unsigned char c) { ВЕРНУТЬ ident_start(c) || ascii_digit(c); }
ЛОГИКА whitespace(unsigned char c) { ВЕРНУТЬ c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\v' || c == '\f'; }
ЛОГИКА starts(const string& s, size_t pos, string_view pattern) {
    ВЕРНУТЬ pos <= s.size() && s.compare(pos, pattern.size(), pattern) == 0;
}

// A small, strict UTF-8 verifier. Our byte offsets stay valid in any locale.
НИЧТО verify_utf8(const string& src) {
    for (size_t i = 0; i < src.size();) {
        unsigned char a = static_cast<unsigned char>(src[i]);
        if (a < 0x80) { ++i; continue; }
        unsigned count = 0;
        if (a >= 0xC2 && a <= 0xDF) count = 2;
        else if (a >= 0xE0 && a <= 0xEF) count = 3;
        else if (a >= 0xF0 && a <= 0xF4) count = 4;
        else throw Heresy("OMN044", "некорректный UTF-8");
        if (i + count > src.size()) throw Heresy("OMN044", "обрезанный UTF-8");
        for (unsigned j = 1; j < count; ++j) {
            unsigned char b = static_cast<unsigned char>(src[i + j]);
            if (b < 0x80 || b > 0xBF) throw Heresy("OMN044", "некорректный UTF-8");
        }
        unsigned char b = static_cast<unsigned char>(src[i + 1]);
        if ((a == 0xE0 && b < 0xA0) || (a == 0xED && b >= 0xA0) ||
            (a == 0xF0 && b < 0x90) || (a == 0xF4 && b >= 0x90))
            throw Heresy("OMN044", "некорректная кодовая точка UTF-8");
        i += count;
    }
}

// R07: every Binary Cant word is one binary octet of a UTF-8 High Gothic text.
// Delimiters are ASCII whitespace, and prayers are still checked after decoding.
string decode_binary_cant(const string& stream) {
    constexpr size_t max_octets = 4 * 1024 * 1024;
    string decoded;
    decoded.reserve(std::min(stream.size() / 9, max_octets));
    size_t cursor = 0, ordinal = 0;
    while (cursor < stream.size()) {
        while (cursor < stream.size() && whitespace(static_cast<unsigned char>(stream[cursor]))) ++cursor;
        if (cursor == stream.size()) break;
        ++ordinal;
        size_t start = cursor;
        unsigned byte = 0;
        while (cursor < stream.size() && !whitespace(static_cast<unsigned char>(stream[cursor]))) {
            unsigned char bit = static_cast<unsigned char>(stream[cursor]);
            if (bit != '0' && bit != '1')
                throw Heresy("OMN060", "осквернённый бинарный октет #" + std::to_string(ordinal));
            if (cursor - start >= 8)
                throw Heresy("OMN060", "осквернённый бинарный октет #" + std::to_string(ordinal));
            byte = (byte << 1) | (bit - '0');
            ++cursor;
        }
        if (cursor - start != 8)
            throw Heresy("OMN060", "осквернённый бинарный октет #" + std::to_string(ordinal));
        if (decoded.size() >= max_octets)
            throw Heresy("OMN062", "предел Binary Cant: 4 MiB");
        decoded.push_back(static_cast<char>(byte));
    }
    try { verify_utf8(decoded); }
    catch (const Heresy&) { throw Heresy("OMN061", "двоичный поток не является допустимым UTF-8"); }
    return decoded;
}

std::vector<Token> lex(const string& src) {
    std::vector<Token> out;
    size_t i = 0;
    int line = 1, col = 1;
    ЛОГИКА line_prefix_whitespace = ИСТИНА;
    while (i < src.size()) {
        size_t begin = i;
        int sl = line, sc = col;
        unsigned char c = static_cast<unsigned char>(src[i]);
        string kind = "punct";
        if (whitespace(c)) {
            kind = "ws";
            do { ++i; } while (i < src.size() && whitespace(static_cast<unsigned char>(src[i])));
        } else if (c == '#' && line_prefix_whitespace) {
            kind = "directive";
            ++i;
            while (i < src.size()) {
                size_t eol = src.find('\n', i);
                if (eol == string::npos) { i = src.size(); break; }
                size_t end = eol;
                while (end > i && (src[end - 1] == '\r' || src[end - 1] == ' ' || src[end - 1] == '\t')) --end;
                ЛОГИКА continuation = end > i && src[end - 1] == '\\';
                i = eol + 1;
                if (!continuation) break;
            }
        } else if (starts(src, i, "//")) {
            kind = "comment";
            size_t eol = src.find('\n', i);
            i = eol == string::npos ? src.size() : eol;
        } else if (starts(src, i, "/*")) {
            kind = "comment";
            size_t end = src.find("*/", i + 2);
            if (end == string::npos) throw Heresy("OMN040", "незакрытый комментарий", Token{kind, "", begin, begin, sl, sc});
            i = end + 2;
        } else {
            // Raw C++ literals, including UTF prefixes: R"tag(...)tag".
            size_t cursor = i;
            if (starts(src, cursor, "u8")) cursor += 2;
            else if (cursor < src.size() && (src[cursor] == 'u' || src[cursor] == 'U' || src[cursor] == 'L')) ++cursor;
            ЛОГИКА raw = starts(src, cursor, "R\"");
            size_t raw_tag_end = string::npos;
            if (raw) {
                raw_tag_end = src.find('(', cursor + 2);
                if (raw_tag_end == string::npos || raw_tag_end - (cursor + 2) > 16) raw = ЛОЖЬ;
                else {
                    for (size_t k = cursor + 2; k < raw_tag_end; ++k) {
                        unsigned char d = static_cast<unsigned char>(src[k]);
                        if (whitespace(d) || d == '(' || d == ')' || d == '\\') { raw = ЛОЖЬ; break; }
                    }
                }
            }
            if (raw) {
                kind = "string";
                string close = ")" + src.substr(cursor + 2, raw_tag_end - cursor - 2) + "\"";
                size_t end = src.find(close, raw_tag_end + 1);
                if (end == string::npos) throw Heresy("OMN041", "незакрытая raw-строка", Token{kind, "", begin, begin, sl, sc});
                i = end + close.size();
            } else {
                cursor = i;
                if (starts(src, cursor, "u8")) cursor += 2;
                else if (cursor < src.size() && (src[cursor] == 'u' || src[cursor] == 'U' || src[cursor] == 'L')) ++cursor;
                ЛОГИКА normal = cursor < src.size() && (src[cursor] == '\"' || src[cursor] == '\'');
                if (normal) {
                    kind = "string";
                    char quote = src[cursor++];
                    i = cursor;
                    ЛОГИКА closed = ЛОЖЬ;
                    while (i < src.size()) {
                        if (src[i] == '\\') i = std::min(i + size_t{2}, src.size());
                        else if (src[i] == quote) { ++i; closed = ИСТИНА; break; }
                        else ++i;
                    }
                    if (!closed) throw Heresy("OMN042", "незакрытая строка или символ", Token{kind, "", begin, begin, sl, sc});
                } else if (ident_start(c)) {
                    kind = "identifier";
                    ++i;
                    while (i < src.size() && ident_rest(static_cast<unsigned char>(src[i]))) ++i;
                } else if (ascii_digit(c)) {
                    kind = "number";
                    ++i;
                    while (i < src.size()) {
                        unsigned char d = static_cast<unsigned char>(src[i]);
                        if (ident_rest(d) || d == '.' || d == '\'') ++i;
                        else break;
                    }
                } else ++i;
            }
        }
        string value = src.substr(begin, i - begin);
        out.push_back(Token{kind, value, begin, i, sl, sc});
        for (size_t k = 0; k < value.size(); ++k) {
            unsigned char d = static_cast<unsigned char>(value[k]);
            if (d == '\n') { ++line; col = 1; line_prefix_whitespace = ИСТИНА; }
            else {
                if ((d & 0xC0) != 0x80) ++col;
                if (d != ' ' && d != '\t' && d != '\r') line_prefix_whitespace = ЛОЖЬ;
            }
        }
    }
    ВЕРНУТЬ out;
}


