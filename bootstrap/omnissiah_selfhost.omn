const std::map<string, string> GOTHIC_LETTERS = {
    {"𐌰", "a"},
    {"𐌱", "b"},
    {"𐌲", "g"},
    {"𐌳", "d"},
    {"𐌴", "e"},
    {"𐌵", "q"},
