#include <vector>
#include <memory>
ВО_ИМЯ_ОМНИССИИ;
ОСВЯТИТЬ процессор;
ОСВЯТИТЬ память;
ВОССЛАВИТЬ машинный_дух;

ШАБЛОН <typename T>
КЛАСС Реликвия {
ПУБЛИЧНО:
    T значение;
    explicit Реликвия(T v) : значение(v) {}
    T удвоить() const { ВЕРНУТЬ значение + значение; }
};

ЛИТАНИЯ главная() {
    АВТО реликвия = std::make_unique<Реликвия<ЦЕЛОЕ>>(21);
    МОЛИТВА("Ответ машинного духа: ", реликвия->удвоить());
    std::vector<ЦЕЛОЕ> данные = {1, 2, 3};
    МОЛИТВА("Размер архива: ", данные.size());
    ВЕРНУТЬ 0;
}
ДА_БУДЕТ_ВОЛЯ_МАШИНЫ;
