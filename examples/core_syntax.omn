// R03 core grammar demonstration: the new AST generates the C++ for this file.
ВО_ИМЯ_ОМНИССИИ;
ОСВЯТИТЬ процессор;
ВОССЛАВИТЬ машинный_дух;

СТРУКТУРА Relic {
    ПУБЛИЧНО:
    ЦЕЛОЕ charge;
    ЦЕЛОЕ double_charge(ЦЕЛОЕ factor) {
        ВЕРНУТЬ charge * factor;
    }
};

ЦЕЛОЕ blessing(ЦЕЛОЕ value) {
    ЕСЛИ_ВОЛЯ_ОМНИССИИ (value < 0) {
        ВЕРНУТЬ 0;
    } ИНАЧЕ {
        ВЕРНУТЬ value + 1;
    }
}

ЛИТАНИЯ главная() {
    ЦЕЛОЕ sum = 0;
    СВЯЩЕННЫЙ_ЦИКЛ (ЦЕЛОЕ i = 0; i < 4; ++i) {
        sum += blessing(i);
    }
    ПОКА_ДУХ_НЕ_УСМИРЕН (sum < 10) {
        sum = sum + 1;
    }
    МОЛИТВА("R03 core: ", sum);
    ВЕРНУТЬ (sum == 10) && ИСТИНА ? 0 : 1;
}
ДА_БУДЕТ_ВОЛЯ_МАШИНЫ;
