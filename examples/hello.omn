ВО_ИМЯ_ОМНИССИИ;
ОСВЯТИТЬ процессор;
ВОССЛАВИТЬ машинный_дух;

ЛИТАНИЯ главная() {
    СТРОКА приветствие = "Привет, мир!";
    МОЛИТВА("Слава Омниссии! ", приветствие);

    ЦЕЛОЕ свечи = 3;
    СВЯЩЕННЫЙ_ЦИКЛ (ЦЕЛОЕ i = 0; i < свечи; ++i) {
        ЕСЛИ_ВОЛЯ_ОМНИССИИ (i % 2 == 0) {
            МОЛИТВА("Литания №", i + 1);
        } ИНАЧЕ {
            МОЛИТВА("Машинный дух благосклонен.");
        }
    }
    ВЕРНУТЬ 0;
}
ДА_БУДЕТ_ВОЛЯ_МАШИНЫ;
